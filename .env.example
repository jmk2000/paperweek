# Copy to .env and select ONE of the options described in README-DOCKER.md.
# Never put Google credentials here for this static/browser-only release.

# Option A: NPM is a container on the same Docker host. Replace the placeholder
# with the name of a network NPM is already attached to (docker network ls).
NPM_NETWORK=REPLACE_WITH_EXISTING_NPM_NETWORK

# Option B: NPM is elsewhere. Replace 127.0.0.1 with this Docker guest's LAN
# address. Loopback is the safe default; another VM cannot reach it.
PAPERWEEK_BIND_IP=127.0.0.1
PAPERWEEK_HOST_PORT=8080

# Maintained tag, deliberately NOT a reproducible digest pin. Override after
# reviewing/pulling the image to pin an approved sha256 digest if required.
NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine
