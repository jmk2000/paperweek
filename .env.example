# Private deployment settings: copy/configure into .env, never commit .env.
# tools/configure_backend.py sets this and generates separate .env.private secrets.
PAPERWEEK_PUBLIC_URL=https://paperweek.example.net

# Shared Docker host: existing network containing Nginx Proxy Manager.
NPM_NETWORK=proxy

# Only for compose.lan.yml. Set the Docker guest's private IP for a remote NPM.
PAPERWEEK_BIND_IP=127.0.0.1
PAPERWEEK_HOST_PORT=8080

# Optional: reviewed base image digest for reproducible deployments.
# PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:...
